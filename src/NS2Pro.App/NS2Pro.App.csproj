<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NS2Pro</AssemblyName>
    <RootNamespace>NS2Pro.App</RootNamespace>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\installer\prerequisites.json" LogicalName="NS2Pro.App.Prerequisites.json" />
    <!-- Component-only self-contained deployment avoids unused AI/ML/Search/Widgets payloads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="..\NS2Pro.Core\NS2Pro.Core.csproj" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\vigem\ViGEmClient.dll" Link="ViGEmClient.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\vigem\LICENSE.txt" Link="Licenses\vgamepad.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\vigem\ViGEmClient-LICENSE.txt" Link="Licenses\ViGEmClient.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\App.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\App.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\App.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishAppResources" AfterTargets="Publish">
    <!-- Unpackaged WinUI still needs its project resource index beside the executable. -->
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
